{
  "trailingSlash": "always",
  "routes": [
    {
      "route": "/account/",
      "redirect": "/pt/conta/",
      "statusCode": 302
    },
    {
      "route": "/pt/conta/*",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/en/conta/*",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/forgekit/",
      "redirect": "/pt/forgekit/",
      "statusCode": 301
    },
    {
      "route": "/stackpick/",
      "redirect": "/pt/stackpick/",
      "statusCode": 301
    },
    {
      "route": "/opengraph-image",
      "headers": {
        "Content-Type": "image/png"
      }
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  }
}
