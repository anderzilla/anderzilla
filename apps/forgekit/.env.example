# Database (SQLite file relative to prisma/)
DATABASE_URL="file:./dev.db"

# Auth — set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-secret"
# Demo mode: skip login and unlock dashboard locally
DEMO_MODE="true"

# Polar.sh — create a product at https://polar.sh then paste IDs
# Docs: https://docs.polar.sh
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRODUCT_ID=""
# Optional: override Polar API base (default https://api.polar.sh/v1)
# POLAR_API_BASE="https://api.polar.sh/v1"

# App URL used for checkout success/cancel redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Primary buy CTA (Gumroad)
NEXT_PUBLIC_GUMROAD_URL="https://anderzilla.gumroad.com/l/edkel"
